# ==============================================================================
# VKU Field Survey — Client Environment Variables
# ==============================================================================
# IMPORTANT SECURITY NOTE:
# Any variable prefixed with VITE_* is bundled into the client-side JavaScript
# assets and is publicly inspectable in any browser. Never place private keys,
# service account secrets, or Google OAuth client secrets in this file.
# ==============================================================================

# Google Apps Script Web App Deployment URL
# Where survey submissions are dispatched via HTTPS POST.
# Format: https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
# Obtain this from Google Apps Script: Deploy -> Manage deployments -> Web app URL
VITE_SUBMISSION_ENDPOINT=

# Optional Client Anti-Abuse Token
# If configured, matches the WRITE_TOKEN property in Google Apps Script Script Properties.
# NOTE: This serves as a lightweight anti-accidental-abuse barrier, NOT confidential authentication.
VITE_SUBMISSION_CLIENT_TOKEN=
